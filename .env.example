# ============================================================
# SAFEGUARD AI — ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép file này thành .env và điền thông tin API Key.
# ============================================================

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🤖 MULTI-LLM PROVIDERS
# Routing: Groq (fastest) → Gemini → Mistral
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# Gemini — Tool-calling agent chính | https://aistudio.google.com
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.0-flash

# Groq — NHANH NHẤT ~300ms, FREE | https://console.groq.com
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=llama-3.3-70b-versatile

# Mistral AI — Tốt với tiếng Việt | https://console.mistral.ai
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY_HERE
MISTRAL_MODEL=mistral-large-latest


# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🔍 THREAT INTELLIGENCE APIs (kiểm tra URL/domain real-time)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# VirusTotal — 90+ AV engines, FREE 4 req/min | https://virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=YOUR_VIRUSTOTAL_API_KEY_HERE

# Google Safe Browsing — FREE 10,000 req/day | https://console.cloud.google.com
# Enable "Safe Browsing API" trong Google Cloud Console
GOOGLE_SAFE_BROWSING_KEY=YOUR_GOOGLE_SAFE_BROWSING_KEY_HERE

# URLScan.io — FREE 100 req/min | https://urlscan.io/user/signup
URLSCAN_API_KEY=YOUR_URLSCAN_API_KEY_HERE

# PhishTank — Không cần API key (public endpoint) | https://phishtank.org

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# 🗄️ SQLITE DATABASE
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Đường dẫn file SQLite Database (mặc định data/safeguard.db)
SAFEGUARD_DB_PATH=data/safeguard.db

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# ⚙️ APPLICATION SETTINGS
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
APP_ENV=development
APP_DEBUG=true
DEFAULT_RISK_THRESHOLD=75
